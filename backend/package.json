    "test:integration:http": "node tests/run-http-integration.js",
    "test:integration:phase1": "node --test tests/phase1-auth-isolation.integration.js",
    "test:integration:phase1-preservation": "node --test tests/phase1-auth-preservation.integration.js",
    "test:integration:phase2-lifecycle": "node --test tests/phase2-memory-lifecycle.integration.js",
    "test:integration:phase2-repository": "node --test tests/phase2-memory-repository.integration.js",
    "test:integration:phase2-fix-regression": "node --test tests/phase2-memory-fix-regression.integration.js",
    "test:integration:phase3": "node --test tests/phase3-memory-concurrency.integration.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tavily/core": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "openai": "^7.55.0",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "zod": "^4.6.7"
